# Database backend
# Leave blank to use local SQLite (instance/c_call_ivr.db) — no Docker required.
# Set to PostgreSQL URL to use Docker/PostgreSQL (run.bat starts it automatically).
DATABASE_URL=
# DATABASE_URL=postgresql://ivr:ivr@127.0.0.1:5432/ivr

# Flask Settings
FLASK_SECRET_KEY=change-me-to-a-long-random-secret-key
HOST=127.0.0.1
PORT=5000

# SIP Defaults (Optionally set here or from the web dashboard Settings tab)
SIP_DOMAIN=
SIP_PORT=5060
SIP_USER=
SIP_PASSWORD=
ASTERISK_DIAL_FORMAT=local_bd

# Call Behaviors
CALL_MAX_DURATION_SECONDS=120
SIP_PROCESS_TIMEOUT_SECONDS=90
GATHER_TIMEOUT_SECONDS=8
RECORD_CALLS=1
CALL_WORKERS=4
FFMPEG_PATH=ffmpeg

# Text-to-Speech providers (optional; can also be saved from Settings)
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
